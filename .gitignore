# Ignore all modules by default (third-party installs).
# Allow the draft GCR Jarvis display module, NODE display module,
# and pinned calendar modules. Other third-party modules stay ignored.
/modules/*
!/modules/.gitkeep
!/modules/MMM-JarvisDisplay/
!/modules/MMM-JarvisDisplay/**
/modules/MMM-JarvisDisplay/node_modules/
!/modules/MMM-NODE/
!/modules/MMM-NODE/**
/modules/MMM-NODE/node_modules/
!/modules/MMM-CalendarExt3/
!/modules/MMM-CalendarExt3/**
/modules/MMM-CalendarExt3/node_modules/
!/modules/MMM-CalendarExt3Agenda/
!/modules/MMM-CalendarExt3Agenda/**
/modules/MMM-CalendarExt3Agenda/node_modules/

# Ignore local override configs; ship the portable env-driven defaults.
config/*
!config/config.js.sample
!config/custom.css.sample
!config/config.js
!config/custom.css

# Vim
## swap
[._]*.s[a-w][a-z]
[._]s[a-w][a-z]

## diff patch
*.orig
*.rej
*.bak

# Ignore positions file (#3518)
js/positions.js

# Ignore lock files other than package-lock.json
pnpm-lock.yaml
yarn.lock

# Vitest temporary test files
tests/**/.tmp/
